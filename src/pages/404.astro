---
import Layout from '../layouts/Layout.astro';
import { getTranslations } from '../utils/translations';

// Los hostings estáticos sirven un único 404.html para cualquier ruta,
// así que la página habla los dos idiomas a la vez.
const es = getTranslations('es').notFound;
const en = getTranslations('en').notFound;
---

<Layout title={es.title} description={es.description} lang="es" noindex>
  <main class="not-found">
    <h1 class="not-found__code display">404</h1>

    <div class="not-found__copy">
      <section>
        <h2 class="heading">{es.heading}</h2>
        <p class="muted">{es.body}</p>
        <a class="button" href="/">{es.home}</a>
      </section>

      <section lang="en">
        <h2 class="heading">{en.heading}</h2>
        <p class="muted">{en.body}</p>
        <a class="button" href="/en/">{en.home}</a>
      </section>
    </div>
  </main>
</Layout>

<style>
  .not-found {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(2rem, 6vw, 4rem);
    padding: var(--margin);
  }

  .not-found__code {
    font-size: var(--step-poster);
    color: var(--accent);
    margin: 0;
  }

  .not-found__copy {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    max-width: 60rem;
  }

  .not-found__copy section {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .not-found__copy h2,
  .not-found__copy p {
    margin: 0;
  }
</style>
