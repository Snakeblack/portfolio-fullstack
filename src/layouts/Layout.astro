---
import portfolioData from "../data/portfolio.json";
import "../styles/global.css";
import type { Locale } from "../utils/translations";

const { social, personalInfo, skills } = portfolioData;

interface Props {
  title: string;
  description: string;
  lang?: Locale;
}

const { title, description, lang = "es" } = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString() : "https://mretamozo.com/";
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = new URL("profile.webp", siteUrl).href;
const twitterHandle = `@${social.twitter.substring(social.twitter.lastIndexOf("/") + 1)}`;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${siteUrl}#person`,
      name: personalInfo.name,
      alternateName: [personalInfo.displayName, "Snakeblack"],
      url: siteUrl,
      image: ogImage,
      sameAs: [social.linkedin, social.github, social.twitter],
      jobTitle: personalInfo.title[lang],
      description: personalInfo.description[lang],
      worksFor: [
        { "@type": "Organization", name: "Hiberus" },
        { "@type": "Organization", name: "Retama", url: "https://retama.dev" },
      ],
      knowsAbout: skills.map((skill) => skill.name),
      email: personalInfo.email,
      workLocation: {
        "@type": "Place",
        address: {
          "@type": "PostalAddress",
          addressLocality: "Madrid",
          addressCountry: "ES",
        },
      },
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      url: siteUrl,
      name: personalInfo.displayName,
      description,
      inLanguage: lang,
      publisher: { "@id": `${siteUrl}#person` },
    },
    {
      "@type": "ProfilePage",
      url: pageUrl,
      name: title,
      description,
      inLanguage: lang,
      isPartOf: { "@id": `${siteUrl}#website` },
      mainEntity: { "@id": `${siteUrl}#person` },
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
	<head>
		<script is:inline>
			if ('scrollRestoration' in history) {
				history.scrollRestoration = 'manual';
			}
			// Las animaciones de carga solo se activan si hay JavaScript.
			document.documentElement.classList.add('js');
		</script>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content={personalInfo.name} />
		<meta name="robots" content="index, follow" />
		<meta name="theme-color" content="#0a0a0a" />
		<meta name="color-scheme" content="dark" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="canonical" href={pageUrl} />
		<link rel="preload" href="/fonts/gambarino-400.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/general-sans-400.woff2" as="font" type="font/woff2" crossorigin />

		<link rel="alternate" hreflang="es" href={new URL("/", siteUrl).href} />
		<link rel="alternate" hreflang="en" href={new URL("/en/", siteUrl).href} />
		<link rel="alternate" hreflang="x-default" href={new URL("/", siteUrl).href} />

		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="profile" />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1024" />
		<meta property="og:image:height" content="1024" />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:site_name" content={personalInfo.displayName} />
		<meta property="og:locale" content={lang === "es" ? "es_ES" : "en_US"} />

		<meta name="twitter:card" content="summary" />
		<meta name="twitter:site" content={twitterHandle} />
		<meta name="twitter:creator" content={twitterHandle} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
		<script>
			import { gsap } from 'gsap';
			import { ScrollTrigger } from 'gsap/ScrollTrigger';

			gsap.registerPlugin(ScrollTrigger);
			ScrollTrigger.config({
				autoRefreshEvents: 'visibilitychange,DOMContentLoaded,load,resize',
				ignoreMobileResize: true,
			});
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>
