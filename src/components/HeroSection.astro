---
import WebGLBackground from './WebGLBackground.astro';

interface Props {
  firstName: string;
  lastName: string;
  role: string;
  description: string;
  intro: string[];
  introLinkText: string;
}

const { firstName, lastName, role, description, intro, introLinkText } = Astro.props;
---

<div class="stage">
  <WebGLBackground />

  <section class="hero" id="top">
    <slot name="nav" />

    <div class="hero__band">
      <p class="hero__lead" data-load style="--d:420ms">{description}</p>
      <h1 class="monument display" aria-label={`${firstName} ${lastName}, ${role}`}>
        <span class="monument__word mask"><span style="--i:0">{firstName}</span></span>{' '}<span class="monument__word mask"><span style="--i:1">{lastName}</span></span>
      </h1>
    </div>
  </section>

  <div class="intro">
    <div class="intro__column">
      {intro.map((paragraph) => <p data-reveal>{paragraph}</p>)}
      <p data-reveal>
        <a class="link" href="#ospec">{introLinkText}</a>
      </p>
    </div>
  </div>
</div>
