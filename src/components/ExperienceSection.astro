---
import type { ExperienceEntry } from '../types/portfolio';
import { getTranslations, type Locale } from '../utils/translations';

interface Props {
  experience: ExperienceEntry[];
  currentLocale: Locale;
}

const { experience, currentLocale } = Astro.props;
const t = getTranslations(currentLocale).experience;

const formatPeriod = ({ from, to }: ExperienceEntry['period']) => (to === null ? `${t.since} ${from}` : `${from}-${to}`);
---

<section class="work" id="work">
  <h2 class="heading section-title" data-reveal>{t.title}</h2>

  <ul class="jobs">
    {experience.map((job) => (
      <li class="experience-item">
        <h3 class="job__name display mask" data-reveal="line"><span>{job.company}</span></h3>
        <div class="job__facts" data-reveal>
          <p class="job__period">
            {formatPeriod(job.period)}
            {job.website && (
              <>
                {' · '}
                <a class="link" href={job.website} target="_blank" rel="noopener noreferrer">{new URL(job.website).hostname}</a>
              </>
            )}
          </p>
          <p class="job__role">{job.position[currentLocale]}</p>
          <p class="job__text">{job.description[currentLocale]}</p>
        </div>
      </li>
    ))}
  </ul>
</section>
