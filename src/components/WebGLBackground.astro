<div class="stage__view">
  <canvas id="webgl-background" class="stage__canvas" aria-hidden="true" role="presentation"></canvas>
</div>

<script>
  const canvas = document.getElementById('webgl-background') as HTMLCanvasElement | null;

  if (canvas) {
    // Three.js se carga después del primer pintado: el titular no espera a la escena.
    const start = () => {
      import('../scene/snake')
        .then(({ mountSnake }) => mountSnake(canvas))
        .catch((error) => {
          // Sin WebGL la página se queda con el nombre y el texto, que no dependen de la escena.
          console.error('No se pudo iniciar la escena 3D:', error);
          canvas.dataset.scene = 'off';
        });
    };

    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(start, { timeout: 1200 });
    } else {
      setTimeout(start, 200);
    }
  }
</script>
