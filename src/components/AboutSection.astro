---
import type { AboutBlock, Fact, SkillEntry } from '../types/portfolio';
import { getTranslations, type Locale } from '../utils/translations';

interface Props {
  content: AboutBlock;
  facts: Fact[];
  skills: SkillEntry[];
  currentLocale: Locale;
}

const { content, facts, skills, currentLocale } = Astro.props;
const t = getTranslations(currentLocale).about;

const columns = [
  { title: t.columns.frontend, items: skills.filter((skill) => skill.category === 'frontend') },
  { title: t.columns.backend, items: skills.filter((skill) => skill.category === 'backend') },
  { title: t.columns.ai, items: skills.filter((skill) => skill.category === 'ai' || skill.category === 'tools') },
];
---

<section class="about" id="about">
  <div class="about__side">
    <h2 class="heading about__title" data-reveal>{t.title}</h2>
    <dl class="facts" data-reveal>
      {facts.map((fact) => (
        <div>
          <dt>{fact.label[currentLocale]}</dt>
          <dd>{fact.value[currentLocale]}</dd>
        </div>
      ))}
    </dl>
  </div>

  <div class="about__main">
    <p class="about__text" data-reveal>{content.paragraph1}</p>
    <p class="about__text" data-reveal>{content.paragraph2}</p>
  </div>

  <h3 class="about__label" data-reveal>{t.stack}</h3>

  <div class="stack">
    {columns.map((column) => (
      <div data-reveal>
        <h4>{column.title}</h4>
        <ul>
          {column.items.map((skill) => <li>{skill.name}</li>)}
        </ul>
      </div>
    ))}
  </div>
</section>
