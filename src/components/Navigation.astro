---
import { getTranslations, type Locale } from '../utils/translations';

interface Props {
  currentLocale: Locale;
  name: string;
  email: string;
}

const { currentLocale, name, email } = Astro.props;
const t = getTranslations(currentLocale);

const homeUrl = currentLocale === 'es' ? '/' : '/en/';
const otherLocaleUrl = currentLocale === 'es' ? '/en/' : '/';
const otherLocale = currentLocale === 'es' ? 'en' : 'es';
const links = [
  { href: '#ospec', label: t.nav.ospec },
  { href: '#work', label: t.nav.work },
  { href: '#projects', label: t.nav.projects },
  { href: '#contact', label: t.nav.contact },
];
---

<header class="nav">
  <a class="nav__mark" href={homeUrl}>{name}</a>
  <nav aria-label={t.nav.main}>
    <button
      class="nav__toggle"
      id="mobile-menu-toggle"
      type="button"
      aria-controls="nav-links"
      aria-expanded="false"
      aria-label={t.nav.menuOpen}
      data-menu-open={t.nav.menuOpen}
      data-menu-close={t.nav.menuClose}
    >
      {t.nav.menu}
    </button>
    <ul class="nav__links" id="nav-links">
      {links.map((item) => (
        <li>
          <a class="plain-link" href={item.href}>{item.label}</a>
        </li>
      ))}
      <li>
        <a class="plain-link" href={otherLocaleUrl} hreflang={otherLocale} lang={otherLocale} aria-label={t.nav.otherLocaleLabel}>
          {t.nav.otherLocale}
        </a>
      </li>
    </ul>
  </nav>
  <a class="button nav__action" href={`mailto:${email}?subject=${encodeURIComponent(t.hero.mailSubject)}`}>{t.hero.action}</a>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const links = document.getElementById('nav-links');

  if (toggle && links) {
    const openLabel = toggle.dataset.menuOpen ?? '';
    const closeLabel = toggle.dataset.menuClose ?? '';

    const setOpen = (open: boolean) => {
      links.toggleAttribute('data-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? closeLabel : openLabel);
      document.body.style.overflow = open ? 'hidden' : '';
    };

    toggle.addEventListener('click', () => setOpen(!links.hasAttribute('data-open')));
    links.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && links.hasAttribute('data-open')) {
        setOpen(false);
        toggle.focus();
      }
    });
    window.matchMedia('(min-width: 48em)').addEventListener('change', () => setOpen(false));
  }
</script>
