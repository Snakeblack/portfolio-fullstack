---
import ThemeToggle from './ThemeToggle.astro';
import { getTranslations } from '../utils/translations.ts';

interface Props {
  currentLocale: 'es' | 'en';
  name: string;
}

const { currentLocale, name } = Astro.props;
const t = getTranslations(currentLocale);

const otherLocaleUrl = currentLocale === 'es' ? '/en' : '/';
const otherLocaleName = currentLocale === 'es' ? 'EN' : 'ES';
const otherLocaleAriaLabel = currentLocale === 'es' ? 'Switch to English version' : 'Cambiar a la versión en español';
const projectGithubUrl = "https://github.com/Snakeblack/portfolio-fullstack";
---

<nav class="fixed top-0 left-0 right-0 z-30">
  {/* Este div es para el fondo a lo ancho completo, blur, borde y sombra */}
  <div id="navbar-background" class="w-full bg-light-bg/70 dark:bg-dark-bg/70 border-b border-light-border/50 dark:border-dark-border/50 backdrop-blur-md shadow-sm transition-all duration-300">
    {/* Este div es para restringir y centrar el contenido */}
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="flex items-center justify-between h-16 md:h-20">
        <a href="https://mretamozo.com" class="font-semibold text-xl md:text-2xl text-light-text dark:text-dark-text tracking-tight mmrg-link">
          {name.split('').map((char, index) => (
            <span class="letter-span" style={`--stagger-delay: ${index * 75}ms`}>{char === ' ' ? '\u00A0' : char}</span>
          ))}
        </a>
      
        <button 
          id="mobile-menu-toggle" 
          class="md:hidden flex items-center justify-center p-2 rounded-md text-light-subtext dark:text-dark-subtext hover:bg-light-card-bg dark:hover:bg-dark-card-bg focus:outline-none focus:ring-2 focus:ring-light-accent dark:focus:ring-dark-accent z-50 transition-colors duration-150"
          aria-controls="nav-content"
          aria-expanded="false"
          data-menu-open={t.nav.menuOpen}
          data-menu-close={t.nav.menuClose}
        >
          <span class="sr-only">{t.nav.menuOpen}</span>
          <div class="relative w-6 h-6">
            <span id="menu-line-1" class="absolute h-0.5 w-full bg-current transform transition-all duration-300 ease-in-out" style="top: 6px; left: 0;"></span>
            <span id="menu-line-2" class="absolute h-0.5 w-full bg-current transform transition-all duration-300 ease-in-out" style="top: 12px; left: 0;"></span>
            <span id="menu-line-3" class="absolute h-0.5 w-full bg-current transform transition-all duration-300 ease-in-out" style="top: 18px; left: 0;"></span>
          </div>
        </button>
      
        <div 
          id="nav-content" 
          class="
            fixed inset-0 z-40 h-dvh 
            bg-light-bg/95 dark:bg-dark-bg/95 backdrop-blur-xl
            flex flex-col items-center justify-center
            transition-all duration-500 ease-in-out
            opacity-0 pointer-events-none
            md:static md:h-auto md:flex-row md:items-center md:justify-end md:bg-transparent md:dark:bg-transparent
            md:backdrop-blur-none md:opacity-100 md:pointer-events-auto md:gap-8 lg:gap-10 md:z-auto
          "
        >
          <ul class="flex flex-col md:flex-row items-center gap-8 md:gap-8 lg:gap-10 text-center">
            {[ 
              { href: "#about", label: t.nav.about },
              { href: "#work", label: t.nav.work },
              { href: "#projects", label: t.nav.projects },
            ].map((item, index) => (
              <li class="nav-item opacity-0 md:opacity-100 transform translate-y-4 md:translate-y-0 transition-all duration-500 ease-out" style={`--delay: ${index * 100}ms`}>
                <a 
                  href={item.href} 
                  class="block py-2 text-4xl md:text-base font-bold md:font-medium text-light-text dark:text-dark-text hover:text-light-accent dark:hover:text-dark-accent transition-colors duration-300 md:hover:bg-transparent"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>

          <div class="mt-12 md:mt-0 flex flex-col md:flex-row items-center gap-8 md:gap-8 lg:gap-10 nav-item opacity-0 md:opacity-100 transform translate-y-4 md:translate-y-0 transition-all duration-500 ease-out" style="--delay: 300ms">
            <a 
              href={otherLocaleUrl} 
              aria-label={otherLocaleAriaLabel}
              class="text-xl md:text-base font-medium text-light-subtext dark:text-dark-subtext hover:text-light-accent dark:hover:text-dark-accent transition-colors duration-200"
            >
              {otherLocaleName}
            </a>
            <div class="scale-125 md:scale-100">
              <ThemeToggle />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</nav>

<style>
  /* Control de backdrop-filter para navbar y menú móvil */
  @media (max-width: 767.98px) {
    #navbar-background {
      backdrop-filter: blur(12px);
    }
    
    /* Cuando el menú está abierto, quitar blur del navbar para que no se superponga raro */
    #navbar-background.menu-open {
      backdrop-filter: none;
      background-color: transparent; /* Make navbar transparent when menu is open */
      border-bottom-color: transparent;
    }
  }

  #mobile-menu-toggle[aria-expanded="true"] #menu-line-1 {
    transform: translateY(0.375rem) rotate(45deg);
  }
  #mobile-menu-toggle[aria-expanded="true"] #menu-line-2 {
    opacity: 0;
    transform: translateX(-100%);
  }
  #mobile-menu-toggle[aria-expanded="true"] #menu-line-3 {
    transform: translateY(-0.375rem) rotate(-45deg);
  }

  /* Mobile Menu Animation States */
  #nav-content.menu-open {
    opacity: 1;
    pointer-events: auto;
  }

  #nav-content.menu-open .nav-item {
    opacity: 1;
    transform: translateY(0);
    transition-delay: var(--delay);
  }

  .mmrg-link .letter-span {
    display: inline-block; /* Allows transform and respects layout */
    position: relative; 
  }

  .mmrg-link:hover .letter-span {
    animation-name: subtleLetterBounce;
    animation-duration: 0.4s;
    animation-timing-function: ease-in-out;
    animation-delay: var(--stagger-delay);
  }

  @keyframes subtleLetterBounce {
    0%, 100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-3px); /* Adjust for desired "bounce" height */
    }
  }

  nav a {
  position: relative;
  text-decoration: none; /* Ensure no default underline interferes */
}

/* Animated underline for desktop navigation links */
@media (min-width: 768px) { /* Corresponds to md: breakpoint */
  .nav-item a::after {
    content: '';
    position: absolute;
    width: 0;
    height: 1.5px; /* Subtle thickness */
    bottom: -5px; /* Position below the text */
    left: 50%;
    transform: translateX(-50%);
    background-color: currentColor; /* Uses the link's current text color (accent on hover) */
    transition: width 0.3s ease-in-out;
  }

  .nav-item a:hover::after,
  .nav-item a:focus::after { /* Apply on hover and focus */
    width: 100%;
  }
}
</style>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const navContent = document.getElementById('nav-content');
  const navbarBackground = document.getElementById('navbar-background');

  if (toggleBtn && navContent && navbarBackground) {
    const srOnlyText = toggleBtn.querySelector('.sr-only');
    const openLabel = toggleBtn.getAttribute('data-menu-open') || 'Open menu';
    const closeLabel = toggleBtn.getAttribute('data-menu-close') || 'Close menu';

    toggleBtn.addEventListener('click', () => {
      const isOpen = navContent.classList.contains('menu-open');
      
      if (isOpen) {
        navContent.classList.remove('menu-open');
        toggleBtn.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
        navbarBackground.classList.remove('menu-open');
        if (srOnlyText) srOnlyText.textContent = openLabel;
      } else {
        navContent.classList.add('menu-open');
        toggleBtn.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
        navbarBackground.classList.add('menu-open');
        if (srOnlyText) srOnlyText.textContent = closeLabel;
      }
    });

    navContent.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        if (navContent.classList.contains('menu-open') && window.innerWidth < 768) {
          navContent.classList.remove('menu-open');
          toggleBtn.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
          navbarBackground.classList.remove('menu-open');
          if (srOnlyText) srOnlyText.textContent = openLabel;
        }
      });
    });
  }
</script>
