---
import type { ProjectEntry } from '../types/portfolio';
import { getTranslations, type Locale } from '../utils/translations';
import { isCover, localizedName, projectPath } from '../utils/projects';

interface Props {
  projects: ProjectEntry[];
  githubUrl: string;
  currentLocale: Locale;
}

const { projects, githubUrl, currentLocale } = Astro.props;
const t = getTranslations(currentLocale).projects;

// El muro desigual: filas de dos, tres, dos y dos. Cada tesela crece en proporción a su imagen
// y toma su altura del aspect-ratio, así que en una fila todas miden lo mismo y ninguna se recorta.
// La variedad de alturas sale de las proporciones de las portadas, no de un recorte.
const rowSizes = [2, 3, 2, 2];

const rows: ProjectEntry[][] = [];
for (let r = 0, cursor = 0; cursor < projects.length; r++) {
  const size = rowSizes[r % rowSizes.length];
  rows.push(projects.slice(cursor, cursor + size));
  cursor += size;
}
---

<section class="projects" id="projects">
  <div class="projects__head">
    <h2 class="projects__title display mask" data-reveal="line"><span>{t.title}</span></h2>
    <a class="link small" href={githubUrl} target="_blank" rel="noopener noreferrer" data-reveal>{t.more}</a>
  </div>

  <div class="wall">
    {rows.map((row) => (
      <div class="wall__row">
        {row.map((project) => (
          <a
            class="tile"
            href={projectPath(project.slug, currentLocale)}
            style={`--ratio: ${(project.width / project.height).toFixed(3)}`}
          >
            <div class="tile__picture" data-reveal="shutter">
              <img
                src={project.screenshot}
                width={project.width}
                height={project.height}
                alt={`${isCover(project.screenshot) ? t.coverAlt : t.screenshotAlt} ${localizedName(project.name, currentLocale)}`}
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="tile__caption">
              <span class="tile__name">{localizedName(project.name, currentLocale)}</span>
              <span class="tile__year">{project.year}</span>
              <p class="tile__text">{project.description[currentLocale]}</p>
            </div>
          </a>
        ))}
      </div>
    ))}
  </div>
</section>
