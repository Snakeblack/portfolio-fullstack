---
import type { ProjectEntry } from '../types/portfolio';
import { getTranslations, type Locale } from '../utils/translations';

interface Props {
  projects: ProjectEntry[];
  githubUrl: string;
  currentLocale: Locale;
}

const { projects, githubUrl, currentLocale } = Astro.props;
const t = getTranslations(currentLocale).projects;

// El muro desigual: cada fila tiene otra altura (en vw) y otro reparto de anchos.
// Sin `weights`, cada tesela ocupa lo que pide la proporción de su imagen.
const rowPlan: { size: number; height: number; weights?: number[] }[] = [
  { size: 2, height: 24 },
  { size: 3, height: 17.5 },
  { size: 2, height: 21, weights: [1.25, 2.1] },
  { size: 2, height: 25, weights: [2.2, 1.4] },
];
// En el teléfono: una a todo el ancho, luego dos a 62/38 y dos a 38/62.
const phonePlan = ['full', 'wide', 'narrow', 'narrow', 'wide'] as const;

const rows: { height: number; tiles: { project: ProjectEntry; weight: number; phone?: string }[] }[] = [];
let cursor = 0;
for (let r = 0; cursor < projects.length; r++) {
  const plan = rowPlan[r % rowPlan.length];
  const slice = projects.slice(cursor, cursor + plan.size);
  rows.push({
    height: plan.height,
    tiles: slice.map((project, i) => ({
      project,
      weight: plan.weights?.[i] ?? project.width / project.height,
      phone: phonePlan[(cursor + i) % phonePlan.length],
    })),
  });
  cursor += plan.size;
}
---

<section class="projects" id="projects">
  <div class="projects__head">
    <h2 class="projects__title display mask" data-reveal="line"><span>{t.title}</span></h2>
    <a class="link small" href={githubUrl} target="_blank" rel="noopener noreferrer" data-reveal>{t.more}</a>
  </div>

  <div class="wall">
    {rows.map((row) => (
      <div class="wall__row" style={`--row-height: clamp(${row.height * 8}px, ${row.height}vw, ${row.height * 18}px)`}>
        {row.tiles.map(({ project, weight, phone }) => (
          <a
            class="tile"
            href={project.url}
            target="_blank"
            rel="noopener noreferrer"
            style={`--ratio: ${weight.toFixed(3)}`}
            data-phone={phone}
          >
            <div class="tile__picture" data-reveal="shutter">
              <img
                src={project.screenshot}
                width={project.width}
                height={project.height}
                alt={`${t.screenshotAlt} ${project.name}`}
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="tile__caption">
              <span class="tile__name">{project.name}</span>
              <span class="tile__year">{project.year}</span>
              <p class="tile__text">{project.description[currentLocale]}</p>
            </div>
          </a>
        ))}
      </div>
    ))}
  </div>
</section>
