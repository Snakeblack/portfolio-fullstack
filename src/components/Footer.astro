---
import type { SocialLinks } from '../types/portfolio';
import { getTranslations, type Locale } from '../utils/translations';

interface Props {
  firstName: string;
  lastName: string;
  copyrightName: string;
  social: SocialLinks;
  currentLocale: Locale;
  /** Fuera de la home, las secciones se enlazan como /#seccion o /en/#seccion. */
  anchorBase?: string;
  /** Esta misma página en el otro idioma; por defecto, la otra home. */
  otherLocaleUrl?: string;
}

const { firstName, lastName, copyrightName, social, currentLocale, anchorBase = '' } = Astro.props;
const t = getTranslations(currentLocale);
const otherLocaleUrl = Astro.props.otherLocaleUrl ?? (currentLocale === 'es' ? '/en/' : '/');
const otherLocale = currentLocale === 'es' ? 'en' : 'es';
const sourceUrl = 'https://github.com/Snakeblack/portfolio-fullstack';
const sections = [
  { href: `${anchorBase}#ospec`, label: t.nav.ospec },
  { href: `${anchorBase}#work`, label: t.nav.work },
  { href: `${anchorBase}#projects`, label: t.nav.projects },
  { href: `${anchorBase}#about`, label: t.nav.about },
  { href: `${anchorBase}#contact`, label: t.nav.contact },
];
---

<footer class="footer">
  <p class="footer__name display"><span class="mask" data-reveal="line"><span>{firstName}</span></span>{' '}<span class="mask" data-reveal="line"><span>{lastName}</span></span></p>

  <div class="footer__row">
    <ul class="footer__places" data-reveal>
      <li><a href={social.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
      <li><a href={social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
      <li><a href={social.twitter} target="_blank" rel="noopener noreferrer">X</a></li>
    </ul>

    <div class="footer__links" data-reveal>
      <div>
        <h3>{t.footer.sections}</h3>
        <ul>
          {sections.map((item) => (
            <li><a class="plain-link" href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h3>{t.footer.site}</h3>
        <ul>
          <li>
            <a class="plain-link" href={otherLocaleUrl} hreflang={otherLocale} lang={otherLocale}>{t.nav.otherLocale}</a>
          </li>
          <li><a class="plain-link" href={sourceUrl} target="_blank" rel="noopener noreferrer">{t.footer.source}</a></li>
          <li>{t.footer.madeWith}</li>
        </ul>
      </div>
    </div>
  </div>

  <div class="footer__legal">
    <p>© {new Date().getFullYear()} {copyrightName}</p>
    <p><a class="plain-link" href="#top">{t.footer.top}</a></p>
  </div>
</footer>
