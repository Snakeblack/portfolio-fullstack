<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { initSmoothAnchors } from "../utils/scrollUtils";

  gsap.registerPlugin(ScrollTrigger);

  function initScrollAnimations() {
    ScrollTrigger.getAll().forEach((trigger) => trigger.kill());

    const media = gsap.matchMedia();
    const animatedElements = Array.from(
      document.querySelectorAll<HTMLElement>('.scroll-animate, .scroll-animate-fast, .title-animate')
    );
    const staggerContainers = Array.from(document.querySelectorAll<HTMLElement>('.stagger-children'));

    media.add('(prefers-reduced-motion: reduce)', () => {
      gsap.set(animatedElements, { opacity: 1, y: 0, scale: 1, clearProps: 'all' });

      staggerContainers.forEach((container) => {
        gsap.set(Array.from(container.children), { opacity: 1, y: 0, scale: 1, clearProps: 'all' });
      });
    });

    media.add('(prefers-reduced-motion: no-preference)', () => {
      animatedElements.forEach((element) => {
        const isFast = element.classList.contains('scroll-animate-fast');
        const isTitle = element.classList.contains('title-animate');
        const isFooter = element.tagName.toLowerCase() === 'footer' || Boolean(element.closest('footer'));

        gsap.set(element, {
          opacity: 0,
          y: isFast ? 3 : isTitle ? 5 : 5,
          scale: 0.99,
          visibility: 'visible',
          clearProps: 'transition,transition-delay',
        });

        ScrollTrigger.create({
          trigger: element,
          start: isFooter ? 'top 88%' : 'top 80%',
          once: true,
          onEnter: () => {
            gsap.to(element, {
              opacity: 1,
              y: 0,
              scale: 1,
              duration: isFast ? 0.5 : isTitle ? 0.7 : 0.9,
              ease: 'power1.out',
              overwrite: 'auto',
            });
          },
        });
      });

      staggerContainers.forEach((container) => {
        const children = Array.from(container.children);

        if (children.length === 0) {
          return;
        }

        gsap.set(children, {
          opacity: 0,
          y: 5,
          scale: 0.99,
          visibility: 'visible',
          clearProps: 'transition,transition-delay',
        });

        ScrollTrigger.create({
          trigger: container,
          start: 'top 85%',
          once: true,
          onEnter: () => {
            gsap.to(children, {
              opacity: 1,
              y: 0,
              scale: 1,
              duration: 0.6,
              stagger: 0.03,
              ease: 'power1.out',
              overwrite: 'auto',
            });
          },
        });
      });
    });

    ScrollTrigger.sort();
    ScrollTrigger.refresh();

    return () => {
      media.revert();
      ScrollTrigger.getAll().forEach((trigger) => trigger.kill());
    };
  }

  let cleanupScrollAnimations = () => {};
  let cleanupAnchors = () => {};

  function revealAnchorTarget(target?: HTMLElement | null) {
    const resolvedTarget = target ?? (window.location.hash ? document.querySelector<HTMLElement>(window.location.hash) : null);
    if (!resolvedTarget) {
      return;
    }

    const revealTargets = Array.from(
      resolvedTarget.querySelectorAll<HTMLElement>('.scroll-animate, .scroll-animate-fast, .title-animate')
    );

    if (resolvedTarget.matches('.scroll-animate, .scroll-animate-fast, .title-animate')) {
      revealTargets.unshift(resolvedTarget);
    }

    if (revealTargets.length === 0) {
      revealTargets.push(resolvedTarget);
    }

    revealTargets.forEach((node) => {
      gsap.to(node, {
        opacity: 1,
        y: 0,
        scale: 1,
        duration: 0.35,
        ease: 'power1.out',
        overwrite: 'auto',
      });
    });

    const staggerContainer = resolvedTarget.querySelector<HTMLElement>('.stagger-children');
    if (staggerContainer) {
      gsap.to(Array.from(staggerContainer.children), {
        opacity: 1,
        y: 0,
        scale: 1,
        duration: 0.45,
        stagger: 0.03,
        ease: 'power1.out',
        overwrite: 'auto',
      });
    }

    const experienceItems = resolvedTarget.querySelectorAll<HTMLElement>('.experience-item');
    if (experienceItems.length > 0) {
      gsap.to(Array.from(experienceItems), {
        opacity: 1,
        y: 0,
        scale: 1,
        duration: 0.4,
        stagger: 0.04,
        ease: 'power1.out',
        overwrite: 'auto',
      });
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    cleanupAnchors();
    cleanupScrollAnimations();

    cleanupAnchors = initSmoothAnchors();
    cleanupScrollAnimations = initScrollAnimations();
  });

  window.addEventListener('load', () => {
    ScrollTrigger.refresh();
  });

  window.addEventListener('hashchange', () => {
    window.setTimeout(revealAnchorTarget, 50);
  });

  document.addEventListener('smooth-anchor:navigate', (event) => {
    const customEvent = event as CustomEvent<{ target?: HTMLElement | null }>;
    window.setTimeout(() => revealAnchorTarget(customEvent.detail?.target ?? null), 50);
  });
</script>
